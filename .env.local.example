# Supabase 프로젝트 설정 (Supabase 대시보드 > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# 절대 클라이언트에 노출하지 마세요. 서버(Route Handler)에서만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (이메일 발송) - https://resend.com 에서 발급
RESEND_API_KEY=your-resend-api-key
# 도메인 인증 전에는 onboarding@resend.dev 를 그대로 사용해도 됩니다.
# 관리자 개인 Gmail을 여기에 절대 넣지 마세요 — 발신 주소는 항상 이 값들로 고정됩니다.
EMAIL_FROM="My Assistant Donna <onboarding@resend.dev>"
SUPPORT_EMAIL_FROM="My Assistant Donna Support <onboarding@resend.dev>"
# 새 문의 등록 시 내부 알림을 받을 주소(선택). 절대 NEXT_PUBLIC_ 로 만들지 마세요.
ADMIN_NOTIFICATION_EMAIL=your-internal-alert-inbox@example.com

# 평일 오전 8:30 Cron 요청을 인증하기 위한 임의의 비밀 문자열 (직접 생성)
CRON_SECRET=change-this-to-a-long-random-string

# ------------------------------------------------------------------
# 아래 값들은 npm run dev에는 필요 없습니다.
# "worklist" Google Sheet를 Claude Code 채팅에서 수동으로 확인/기록할 때만 사용됩니다.
# 자세한 내용은 README "13. 개선작업 Google Sheet 연동" 참고.
# ------------------------------------------------------------------
# GOOGLE_SHEET_ID=your-google-sheet-id
# GOOGLE_SHEET_NAME=worklist
# 다운로드한 서비스 계정 JSON 키 파일 경로 (권장 — 줄바꿈 이슈 없음, secrets/ 는 gitignore됨)
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/google-service-account.json
